# ==============================================================================
# SGX VENDOR WORK EVIDENCE & REPORTING SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Environment Mode ('development' | 'production')
NODE_ENV=development

# Server Port
PORT=5000

# JSON Web Token Secret Key (Wajib diisi dengan string acak yang kuat di server hosting)
JWT_SECRET=sgx_enterprise_production_jwt_secret_key_2026_x89a7f3b41c9e8d7a6b5c4

# CORS Allowed Origins (Pisahkan dengan koma jika lebih dari satu domain)
# Contoh di hosting: https://vendor.sgx.co.id,https://app.sgx.co.id,http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000

# Path direktori penyimpanan foto upload (Opsional, default: /uploads di root project)
# UPLOADS_DIR=/var/www/sgx_vendor/uploads
