# ==============================================================================
# SGX VENDOR WORK EVIDENCE & REPORTING SYSTEM - ENVIRONMENT TEMPLATE
# Salin file ini menjadi .env pada server hosting Anda: cp .env.example .env
# ==============================================================================

# Server Environment Mode ('development' | 'production')
NODE_ENV=production

# Server Port
PORT=5000

# JSON Web Token Secret Key (Ganti dengan string rahasia unik dan panjang)
JWT_SECRET=your_super_secret_production_jwt_key_here_change_me_in_hosting

# CORS Whitelist Origins (Masukkan domain hosting frontend Anda, pisahkan dengan koma)
CORS_ORIGIN=https://your-domain.com,https://vendor.your-domain.com,http://localhost:3000

# Path direktori penyimpanan uploads (Opsional)
# UPLOADS_DIR=/absolute/path/to/uploads

# WhatsApp Gateway (Fonnte) Configuration
# Dapatkan token resmi dari dashboard Fonnte (https://md.fonnte.com/ -> Tombol 'Token' pada Device)
FONNTE_TOKEN=
# Set true HANYA untuk local testing tanpa kuota. Di production WAJIB false.
FONNTE_MOCK_MODE=false
FONNTE_URL=https://api.fonnte.com/send

